# Application Configuration
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://tutor-scence-frontend.s3-website-us-east-1.amazonaws.com
BACKEND_URL=http://localhost:3000
API_PREFIX=api/v1
SWAGGER_PATH=docs

# CORS Configuration
CORS_ORIGIN=*

# Database Configuration (PostgreSQL)
# For AWS RDS, use the RDS endpoint as DB_HOST
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_db_password
DB_NAME=tutor_scene_db
DB_SSL=false
DATABASE_LOGGING=false
DATABASE_CONNECTION_LIMIT=10

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_in_production_minimum_32_characters
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your_refresh_token_secret_change_in_production
REFRESH_TOKEN_EXPIRES_IN=7d

# Redis Configuration (for caching and rate limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=3600

# AWS S3 Configuration (for file uploads)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=tutor-scene-uploads
AWS_S3_PROFILE_PHOTOS_FOLDER=profile-photos
AWS_S3_RESUMES_FOLDER=resumes
AWS_S3_DOCUMENTS_FOLDER=documents
AWS_S3_RECORDINGS_FOLDER=recordings
USE_LOCAL_FILE_STORAGE=false

# Stripe Configuration (for payments)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PLATFORM_FEE_PERCENTAGE=15
STRIPE_CURRENCY=usd

# Zoom Configuration (for interview video sessions - Server-to-Server OAuth)
ZOOM_ACCOUNT_ID=your_zoom_account_id
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret

# SMTP Configuration (for email sending)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=Tutor-Scene

# Checkr Configuration (for background checks)
CHECKR_API_KEY=your_checkr_api_key
CHECKR_ENVIRONMENT=sandbox
CHECKR_PACKAGE_SLUG=tasker_pro

# SendGrid Configuration (for emails)
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@tutorscene.com
SENDGRID_FROM_NAME=Tutor Scene

# Twilio Configuration (for SMS)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Google Calendar Configuration (optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://tutor-scence-frontend.s3-website-us-east-1.amazonaws.com/api/calendar/callback

# Persona Configuration (optional - for KYC)
PERSONA_API_KEY=your_persona_api_key
PERSONA_ENVIRONMENT=sandbox

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# Session/Cookie Configuration
SESSION_SECRET=your_session_secret_change_in_production

# Monitoring (optional)
SENTRY_DSN=your_sentry_dsn

# Analytics (optional)
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
MIXPANEL_TOKEN=your_mixpanel_token
